# InsightFlow AI configuration (all optional — offline defaults work out of the box)

# --- Database ---
# Default SQLite; switch to Postgres by setting DATABASE_URL, e.g.:
# DATABASE_URL=postgresql+psycopg2://readonly_user:pass@localhost:5432/insightflow
DATABASE_URL=sqlite:///data/insightflow.db

# --- LLM provider ---
# One of: offline | openai | local
LLM_PROVIDER=offline
LLM_MODEL=gpt-4o-mini

# Only used when LLM_PROVIDER=openai
OPENAI_API_KEY=

# Only used when LLM_PROVIDER=local (Ollama / vLLM / LM Studio, OpenAI-compatible)
LLM_BASE_URL=http://localhost:11434/v1

# --- Decision policy thresholds ---
CONF_HIGH=0.70
CONF_LOW=0.40
